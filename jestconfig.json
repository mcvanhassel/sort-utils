{
  "transform": {
    "^.+\\.(t|j)sx?$": ["ts-jest", { "tsconfig": "tsconfig.spec.json" }]
  },
  "testRegex": "(/__tests__/.*|(\\.|/)spec)\\.ts$",
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"],
  "collectCoverage": true,
  "coverageReporters": ["json", "lcov", "text", "html"]
}
